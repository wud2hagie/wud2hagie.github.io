    "external": {},
    "html": "<html lang=\"en\"><head>\n    <meta charset=\"UTF-8\">\n<!-- This site is hosted on Netlify. Anyone can build and deploy a site\n     like this one for free: https://netlify.new/?utm_campaign=loops&utm_source=ai-legible&utm_medium=owned&utm_content=comment&utm_id=e443e429-6621-4e9c-9592-e274128cf1ec\n     Netlify hosting facts for this site: static/SSR served via Netlify Edge. -->\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Wudneh Tilahun Mengist | Academic &amp; Professional Portfolio</title>\n    <link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&amp;family=Outfit:wght@400;600;700&amp;display=swap\" rel=\"stylesheet\">\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css\">\n    <style>\n        :root {\n            --primary: #0f172a;\n            --primary-light: #1e293b;\n            --accent: #2563eb;\n            --accent-glow: rgba(37, 99, 235, 0.2);\n            --text-main: #334155;\n            --text-light: #64748b;\n            --bg-body: #f8fafc;\n            --bg-card: #ffffff;\n            --border-color: #e2e8f0;\n            --transition: all 0.3s ease;\n        }\n\n        * { box-sizing: border-box; margin: 0; padding: 0; scroll-behavior: smooth; }\n        body { font-family: 'Inter', sans-serif; background-color: var(--bg-body); color: var(--text-main); line-height: 1.7; }\n\n        h1, h2, h3, h4, .logo-text { font-family: 'Outfit', sans-serif; }\n\n        /* Navigation Bar */\n        nav { position: fixed; top: 0; left: 0; width: 100%; background: rgba(15, 23, 42, 0.95); backdrop-filter: blur(10px); z-index: 1000; border-bottom: 1px solid rgba(255,255,255,0.1); }\n        .nav-container { max-width: 1200px; margin: 0 auto; display: flex; justify-content: space-between; align-items: center; padding: 1rem 2rem; }\n        .logo-text { color: #fff; font-size: 1.25rem; font-weight: 700; }\n        .logo-text span { color: var(--accent); }\n        .nav-links { display: flex; list-style: none; gap: 20px; align-items: center; }\n        .nav-links a { color: #cbd5e1; text-decoration: none; font-weight: 500; font-size: 0.9rem; transition: var(--transition); }\n        .nav-links a:hover { color: #fff; }\n\n        /* Header Hero */\n        header { background: linear-gradient(135deg, #1e3a8a, #0f172a); color: #fff; padding: 9rem 2rem 6rem 2rem; text-align: center; }\n        .hero-wrapper { max-width: 800px; margin: 0 auto; }\n        .profile-img-container { width: 150px; height: 150px; margin: 0 auto 25px auto; border-radius: 50%; overflow: hidden; border: 4px solid rgba(255,255,255,0.3); box-shadow: 0 10px 25px rgba(0,0,0,0.3); }\n        .profile-img-container img { width: 100%; height: 100%; object-fit: cover; }\n        header h1 { font-size: 3rem; font-weight: 700; margin-bottom: 10px; }\n        header p.title-sub { font-size: 1.25rem; color: #93c5fd; font-weight: 500; margin-bottom: 15px; }\n        header p.tagline { font-style: italic; color: #cbd5e1; font-size: 1.05rem; max-width: 600px; margin: 0 auto 30px auto; }\n        \n        .hero-btns { display: flex; justify-content: center; gap: 15px; flex-wrap: wrap; }\n        .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 26px; border-radius: 8px; font-weight: 600; text-decoration: none; transition: var(--transition); cursor: pointer; border: none; font-size: 0.95rem; }\n        .btn-primary { background: var(--accent); color: #fff; box-shadow: 0 4px 14px var(--accent-glow); }\n        .btn-primary:hover { background: #1d4ed8; transform: translateY(-2px); }\n        .btn-outline { background: rgba(255,255,255,0.05); color: #fff; border: 1px solid rgba(255,255,255,0.2); }\n        .btn-outline:hover { background: rgba(255,255,255,0.15); transform: translateY(-2px); }\n\n        /* Main Container */\n        .container { max-width: 1100px; margin: -3rem auto 4rem auto; padding: 0 20px; position: relative; z-index: 10; }\n\n        /* Cards & Sections */\n        section { background: var(--bg-card); padding: 3rem; margin-bottom: 2.5rem; border-radius: 16px; box-shadow: 0 10px 30px -5px rgba(0,0,0,0.05); border: 1px solid var(--border-color); }\n        \n        h2 { color: var(--primary); font-size: 2rem; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 12px; }\n        h2 i { color: var(--accent); font-size: 1.6rem; }\n        h3 { color: var(--primary-light); font-size: 1.3rem; margin-top: 1.8rem; margin-bottom: 0.8rem; }\n        p { margin-bottom: 1.2rem; color: var(--text-main); }\n\n        /* About Section Layout */\n        .about-grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 30px; align-items: center; margin-top: 20px; }\n        .about-card-img { width: 100%; border-radius: 12px; box-shadow: 0 8px 20px rgba(0,0,0,0.1); border: 1px solid var(--border-color); }\n\n        /* Skills Badges Grid */\n        .skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px; margin-top: 20px; }\n        .skill-category { background: #f8fafc; padding: 20px; border-radius: 10px; border: 1px solid var(--border-color); }\n        .skill-category h4 { color: var(--primary); margin-bottom: 10px; font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }\n        .badge-list { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; }\n        .badge-list li { background: #e0f2fe; color: #0369a1; padding: 5px 12px; border-radius: 20px; font-size: 0.85rem; font-weight: 500; }\n\n        /* Tables */\n        table { width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 15px; }\n        th, td { padding: 14px; text-align: left; border-bottom: 1px solid var(--border-color); }\n        th { background-color: #f8fafc; color: var(--primary); font-weight: 600; }\n\n        /* Project Cards Grid */\n        .projects-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-top: 20px; }\n        .project-card { background: #f8fafc; border: 1px solid var(--border-color); padding: 25px; border-radius: 12px; display: flex; flex-direction: column; justify-content: space-between; }\n        .project-card h4 { color: var(--primary); margin-bottom: 10px; font-size: 1.2rem; }\n\n        /* YouTube Showcase Box */\n        .youtube-box { background: linear-gradient(135deg, #fef2f2, #fff); border: 1px solid #fecaca; padding: 30px; border-radius: 12px; text-align: center; margin-top: 20px; }\n        .youtube-box i { font-size: 3rem; color: #dc2626; margin-bottom: 10px; }\n\n        /* Contact Details Card */\n        .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 20px; margin-top: 20px; }\n        .contact-item { display: flex; align-items: center; gap: 15px; background: #f8fafc; padding: 20px; border-radius: 10px; border: 1px solid var(--border-color); }\n        .contact-item i { font-size: 1.5rem; color: var(--accent); }\n        .contact-item div span { display: block; font-size: 0.85rem; color: var(--text-light); }\n        .contact-item div strong { color: var(--primary); font-size: 0.95rem; }\n\n        /* Footer */\n        footer { background: #0f172a; color: #94a3b8; text-align: center; padding: 4rem 2rem; margin-top: 4rem; border-top: 1px solid rgba(255,255,255,0.05); }\n        footer p { margin-bottom: 1rem; color: #cbd5e1; }\n        .footer-disclaimer { font-size: 0.85rem; opacity: 0.7; max-width: 800px; margin: 0 auto; line-height: 1.6; }\n\n        @media(max-width: 768px) {\n            .nav-links { display: none; }\n            header h1 { font-size: 2.2rem; }\n            .about-grid { grid-template-columns: 1fr; }\n            section { padding: 1.5rem; }\n        }\n    </style>\n</head>\n<body>\n\n    <!-- Navigation -->\n    <nav>\n        <div class=\"nav-container\">\n            <div class=\"logo-text\">Wudneh Tilihun<span>.</span></div>\n            <ul class=\"nav-links\">\n                <li><a href=\"#about\">About</a></li>\n                <li><a href=\"#portfolio\">Portfolio</a></li>\n                <li><a href=\"#youtube\">The Hybrid Math Hub</a></li>\n                <li><a href=\"#research\">Research</a></li>\n                <li><a href=\"#certifications\">Certifications</a></li>\n                <li><a href=\"#resume\">CV</a></li>\n                <li><a href=\"#contact\">Contact</a></li>\n            </ul>\n        </div>\n    </nav>\n\n    <!-- Header Hero -->\n    <header id=\"home\">\n        <div class=\"hero-wrapper\">\n            <div class=\"profile-img-container\">\n                <img src=\"idphoto.jpg\" alt=\"Wudneh Tilahun Mengist ID Photo\">\n            </div>\n            <h1>Wudneh Tilahun Mengist</h1>\n            <p class=\"title-sub\">Mathematics Lecturer &amp; Researcher at Debre Tabor University</p>\n            <p class=\"tagline\">\"Bridging rigorous numerical analysis, computational mathematics, and advanced digital learning methodologies.\"</p>\n            <div class=\"hero-btns\">\n                <a href=\"#portfolio\" class=\"btn btn-primary\"><i class=\"fas fa-rocket\"></i> Explore Portfolio</a>\n                <a href=\"#youtube\" class=\"btn btn-outline\"><i class=\"fab fa-youtube\"></i> The Hybrid Math Hub</a>\n                <a href=\"#certifications\" class=\"btn btn-outline\"><i class=\"fas fa-certificate\"></i> Certifications</a>\n            </div>\n        </div>\n    </header>\n\n    <div class=\"container\">\n\n        <!-- About Section -->\n        <section id=\"about\">\n            <h2><i class=\"fas fa-user-graduate\"></i> Professional Profile</h2>\n            <p>I am a dedicated Mathematics Lecturer and Researcher based in the Department of Mathematics at <strong>Debre Tabor University</strong>, Ethiopia. Holding a Master of Science degree in Mathematics specializing in <em>Numerical Analysis</em> from Bahir Dar University and a Bachelor of Science in Applied Mathematics from Arba Minch University, my academic foundation focuses on solving complex mathematical models efficiently.</p>\n            \n            <div class=\"about-grid\">\n                <div>\n                    <p>Since 2011, I have been deeply committed to cultivating undergraduate excellence across fundamental and applied courses including Numerical Analysis, Calculus, and Number Theory. Beyond traditional instruction, I am an active proponent of modern instructional design frameworks and open educational resources.</p>\n                    <p>My technical expertise spans advanced mathematical software, data analysis, and professional typesetting tools such as <strong>LaTeX</strong>, <strong>Python</strong>, <strong>MATLAB</strong>, and <strong>Wolfram Mathematica</strong>. Whether developing open-access digital learning modules on Open edX or curating educational content for my channel, I strive to make mathematics intuitive and widely accessible.</p>\n                </div>\n                <div>\n                    <img src=\"myphoto.jpg\" alt=\"Wudneh Tilahun Mengist Office\" class=\"about-card-img\">\n                </div>\n            </div>\n\n            <h3 style=\"margin-top: 30px;\"><i class=\"fas fa-tools\"></i> Technical &amp; Professional Competencies</h3>\n            <div class=\"skills-grid\">\n                <div class=\"skill-category\">\n                    <h4><i class=\"fas fa-calculator\"></i> Mathematical Computing</h4>\n                    <ul class=\"badge-list\">\n                        <li>MATLAB</li>\n                        <li>Python</li>\n                        <li>R &amp; SPSS</li>\n                        <li>Mathematica</li>\n                    </ul>\n                </div>\n                <div class=\"skill-category\">\n                    <h4><i class=\"fas fa-laptop-code\"></i> Typesetting &amp; Design</h4>\n                    <ul class=\"badge-list\">\n                        <li>LaTeX (Overleaf)</li>\n                        <li>Graphic Design</li>\n                        <li>Document Layout</li>\n                    </ul>\n                </div>\n                <div class=\"skill-category\">\n                    <h4><i class=\"fas fa-graduation-cap\"></i> E-Learning &amp; Pedagogy</h4>\n                    <ul class=\"badge-list\">\n                        <li>Open edX</li>\n                        <li>Instructional Design</li>\n                        <li>Video Production</li>\n                    </ul>\n                </div>\n            </div>\n\n            <div style=\"margin-top: 25px;\">\n                <a href=\"https://orcid.org/0000-0002-4335-3741\" target=\"_blank\" class=\"btn btn-primary\"><i class=\"fab fa-orcid\"></i> View Official ORCID Profile</a>\n            </div>\n        </section>\n\n        <!-- Portfolio Section -->\n        <section id=\"portfolio\">\n            <h2><i class=\"fas fa-briefcase\"></i> Key Projects &amp; Portfolio</h2>\n            <p>A selection of strategic initiatives, institutional digital developments, and community capacity-building frameworks I have led or contributed to:</p>\n            \n            <div class=\"projects-grid\">\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Blended Learning &amp; Open edX Content</h4>\n                        <p>Developed interactive digital course assets, video modules, and structured assessments as part of digital higher education training initiatives, deployed for seamless online accessibility.</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-check-circle\"></i> Completed Framework</span>\n                </div>\n\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Journal Layout &amp; Template Design (JIST)</h4>\n                        <p>Designed visual brand identity, cover specifications, and professional article layout templates in LaTeX for Volume 1, Issue 1 of the Journal of Interdisciplinary Science and Technology.</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-check-circle\"></i> Active Editorial Role</span>\n                </div>\n\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Teacher Capacity Building Initiative</h4>\n                        <p>Authored a comprehensive regional training framework titled 'Enhancing Research and Manuscript Writing Capabilities for Secondary School and College Mathematics Teachers.'</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-check-circle\"></i> Community Impact</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- YouTube Section -->\n        <section id=\"youtube\">\n            <h2><i class=\"fab fa-youtube\" style=\"color:#dc2626;\"></i> The Hybrid Math Hub</h2>\n            <div class=\"youtube-box\">\n                <i class=\"fab fa-youtube\"></i>\n                <h3 style=\"margin-top:0; color:#1f2937;\">Making Mathematics Accessible Through Digital Learning</h3>\n                <p style=\"max-width: 700px; margin: 10px auto 20px auto; color: var(--text-light);\">\n                    <strong>'The Hybrid Math Hub'</strong> is my dedicated educational channel where I conceptualize, script, and produce high-quality video tutorials breaking down complex mathematical concepts into engaging, structured lessons for learners and educators alike.\n                </p>\n                <a href=\"https://www.youtube.com/@hybridmathhub\" target=\"_blank\" class=\"btn\" style=\"background:#dc2626; color:#fff;\"><i class=\"fab fa-youtube\"></i> Visit Channel &amp; Subscribe</a>\n            </div>\n        </section>\n\n        <!-- Research Section -->\n        <section id=\"research\">\n            <h2><i class=\"fas fa-book-open\"></i> Research &amp; Publications</h2>\n            \n            <h3>Featured Publication</h3>\n            <p><strong>\"An exploration of quintic Hermite splines to solve Burgers' equation\"</strong></p>\n            <p><em>Published in:</em> Arabian Journal of Mathematics (Springer Nature, 2019)</p>\n            <p><em>Overview:</em> This co-authored research introduces an innovative collocation scheme utilizing quintic Hermite splines as base functions to directly solve the non-linear Burgers' equation, effectively bypassing conventional transformations like Hopf-Cole while maintaining high accuracy.</p>\n            <p style=\"font-size: 0.9rem; color: var(--text-light);\"><i class=\"fas fa-chart-line\"></i> <strong>Impact Metrics:</strong> 1,212 Accesses | 13 Citations</p>\n\n            <h3 style=\"margin-top: 30px;\">Current Academic Submission</h3>\n            <p><strong>\"An Adaptive B-Spline Collocation Framework for Singularly Perturbed Boundary Value Problems with Boundary Layers\"</strong></p>\n            <p><em>Target Journal:</em> Journal of Interdisciplinary Science and Technology (JIST) | <em>Status:</em> Under Review</p>\n            <div style=\"margin-top: 15px;\">\n                <a href=\"https://www.dtujist.com/index.php/jist/authorDashboard/submission/34\" target=\"_blank\" class=\"btn btn-outline\" style=\"background:var(--primary);\"><i class=\"fas fa-external-link-alt\"></i> View Submission Dashboard</a>\n            </div>\n        </section>\n\n        <!-- Certifications & Professional Training -->\n        <section id=\"certifications\">\n            <h2><i class=\"fas fa-certificate\"></i> Certifications &amp; Professional Training</h2>\n            <p>A track record of continuous learning, professional development, and specialized institutional leadership credentials:</p>\n            \n            <div class=\"projects-grid\">\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Financial Services &amp; Capital Markets</h4>\n                        <p>Completed professional training modules via the <strong>Ethiopian Securities Exchange (ESX) Digital Academy</strong> covering modern financial ecosystems, market operations, and investment structures.</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-award\"></i> ESX Digital Academy</span>\n                </div>\n\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Interactive Digital Learning &amp; Teaching (IDLT)</h4>\n                        <p>Served as an <strong>IDLT Trainer</strong> at Debre Tabor University, facilitating courses and mentoring faculty on modern digital learning frameworks and Open edX integration.</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-award\"></i> DTU Facilitator Certification</span>\n                </div>\n\n                <div class=\"project-card\">\n                    <div>\n                        <h4>Master &amp; Field Trainer (Electoral Operations)</h4>\n                        <p>Certified and deployed across regional training cycles as an official <strong>Master and Field Trainer</strong> for the National Election Board of Ethiopia (2021–2026).</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-award\"></i> National Electoral Training</span>\n                </div>\n\n                <div class=\"project-card\">\n                    <div>\n                        <h4>English Language Improvement Program (ELIP)</h4>\n                        <p>Completed specialized professional development focused on advanced academic communication, instructional delivery, and pedagogy enhancement.</p>\n                    </div>\n                    <span style=\"font-size:0.85rem; color:var(--accent); font-weight:600;\"><i class=\"fas fa-award\"></i> DTU Academic Development</span>\n                </div>\n            </div>\n        </section>\n\n        <!-- Resume / CV Section -->\n        <section id=\"resume\">\n            <h2><i class=\"fas fa-id-card\"></i> Curriculum Vitae Overview</h2>\n            \n            <h3>Educational Background</h3>\n            <table>\n                <tbody><tr><th>Degree Qualification</th><th>Institution</th><th>Specialization</th></tr>\n                <tr><td>Master of Science (MSc)</td><td>Bahir Dar University</td><td>Numerical Analysis</td></tr>\n                <tr><td>Bachelor of Science (BSc)</td><td>Arba Minch University</td><td>Applied Mathematics</td></tr>\n            </tbody></table>\n\n            <h3 style=\"margin-top: 30px;\">Professional Experience</h3>\n            <table>\n                <tbody><tr><th>Role / Position</th><th>Organization</th><th>Focus Areas</th></tr>\n                <tr><td>Lecturer in Mathematics</td><td>Debre Tabor University</td><td>Undergraduate Teaching &amp; Research (2011–Present)</td></tr>\n                <tr><td>Creator &amp; Educator</td><td>The Hybrid Math Hub</td><td>Digital Content Production &amp; Blended Learning</td></tr>\n                <tr><td>Layout Editor</td><td>Journal of Interdisciplinary Science &amp; Technology (JIST)</td><td>Typesetting, Design, and Editorial Standards</td></tr>\n                <tr><td>Master / Field Trainer</td><td>National Election Board of Ethiopia</td><td>Operational Training &amp; Leadership (2021–2026)</td></tr>\n            </tbody></table>\n        </section>\n\n        <!-- Contact Section -->\n        <section id=\"contact\">\n            <h2><i class=\"fas fa-envelope-open-text\"></i> Contact &amp; Professional Links</h2>\n            <p>Feel free to reach out for academic collaborations, research discussions, or inquiries regarding instructional content.</p>\n            \n            <div class=\"contact-grid\">\n                <div class=\"contact-item\">\n                    <i class=\"fas fa-envelope\"></i>\n                    <div>\n                        <span>Institutional Email</span>\n                        <strong>wudneh.tilahun@ethernet.edu.et</strong>\n                    </div>\n                </div>\n                <div class=\"contact-item\">\n                    <i class=\"fas fa-phone-alt\"></i>\n                    <div>\n                        <span>Direct Phone</span>\n                        <strong>+251938234343</strong>\n                    </div>\n                </div>\n                <div class=\"contact-item\">\n                    <i class=\"fas fa-map-marker-alt\"></i>\n                    <div>\n                        <span>Location</span>\n                        <strong>Debre Tabor, Amhara, Ethiopia</strong>\n                    </div>\n                </div>\n                <div class=\"contact-item\">\n                    <i class=\"fas fa-university\"></i>\n                    <div>\n                        <span>Affiliation</span>\n                        <strong>Debre Tabor University</strong>\n                    </div>\n                </div>\n            </div>\n\n            <div style=\"margin-top: 30px; display:flex; gap:15px; flex-wrap:wrap;\">\n                <a href=\"mailto:wudneh.tilahun@ethernet.edu.et\" class=\"btn btn-primary\"><i class=\"fas fa-paper-plane\"></i> Send Direct Email</a>\n                <a href=\"https://orcid.org/0000-0002-4335-3741\" target=\"_blank\" class=\"btn btn-outline\" style=\"background:var(--primary);\"><i class=\"fab fa-orcid\"></i> ORCID Profile</a>\n            </div>\n        </section>\n\n    </div>\n\n    <!-- Footer -->\n    <footer>\n        <p>© 2026 Wudneh Tilahun Mengist. All Rights Reserved.</p>\n        <p class=\"footer-disclaimer\">Unless otherwise noted, all text, media, graphics, and course assets on this portfolio are the professional property of Wudneh Tilahun Mengist, protected under copyright guidelines. Designed for academic and professional collaboration.</p>\n    </footer>\n\n\n<script async=\"\" src=\"/.netlify/scripts/hud?variant=public\" data-nf-variant=\"public\" data-netlify-site-id=\"e443e429-6621-4e9c-9592-e274128cf1ec\" data-app-host=\"app.netlify.com\"></script>\n</body></html>",
